<section class="mt-page"><div class="mt-page-header"><div><p class="mt-eyebrow">CASH CONTROL</p><h1>Expenses</h1><p>Record branch operating expenses and cash drawer deductions.</p></div></div>
<div class="mt-two-column"><article class="mt-panel"><div class="mt-panel-header"><div><h2>Recent expenses</h2></div></div><div class="mt-table-wrap"><table class="mt-table"><thead><tr><th>Date</th><th>Category</th><th>Description</th><th>Method</th><th>Amount</th></tr></thead><tbody>{{#each expenses}}<tr><td>{{dateTime created_at}}</td><td><strong>{{category}}</strong></td><td>{{description}}</td><td>{{payment_method}}</td><td><strong>TZS {{money amount}}</strong></td></tr>{{else}}<tr><td colspan="5"><div class="mt-empty-state">No expenses yet.</div></td></tr>{{/each}}</tbody></table></div></article>
<article class="mt-panel mt-form-panel"><div class="mt-panel-header"><div><h2>Add expense</h2></div></div><form method="post" class="mt-panel-body mt-form-stack"><label>Category<input name="category" placeholder="Transport, utilities..." required></label><label>Description<textarea name="description" rows="3"></textarea></label><label>Amount<input type="number" min="0.01" step="0.01" name="amount" required></label><label>Payment method<select name="payment_method"><option>CASH</option><option>MOBILE_MONEY</option><option>CARD</option><option>BANK</option></select></label><button class="mt-btn mt-btn-primary mt-btn-lg">Record expense</button></form></article></div></section>