<section class="mt-page"><div class="mt-page-header"><div><p class="mt-eyebrow">SYSTEM</p><h1>Settings</h1><p>Pharmacy identity, current branch and receipt configuration.</p></div></div><form method="post" class="mt-settings-grid"><article class="mt-panel mt-form-panel"><div class="mt-panel-header"><div><h2>Pharmacy</h2></div></div><div class="mt-panel-body mt-form-stack"><label>Name<input name="organization_name" value="{{organization.name}}" required></label><label>Phone<input name="organization_phone" value="{{organization.phone}}"></label><label>Email<input type="email" name="organization_email" value="{{organization.email}}"></label><label>Address<textarea name="organization_address">{{organization.address}}</textarea></label></div></article><article class="mt-panel mt-form-panel"><div class="mt-panel-header"><div><h2>{{branch.name}}</h2></div></div><div class="mt-panel-body mt-form-stack"><label>Branch name<input name="branch_name" value="{{branch.name}}" required></label><label>Phone<input name="branch_phone" value="{{branch.phone}}"></label><label>Address<textarea name="branch_address">{{branch.address}}</textarea></label><label>Receipt footer<input name="receipt_footer" value="{{config.receipt.footer}}" placeholder="Thank you"></label><button class="mt-btn mt-btn-primary mt-btn-lg">Save settings</button></div></article></form></section>