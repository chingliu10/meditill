<section class="mt-page"><div class="mt-page-header"><div><p class="mt-eyebrow">PROCUREMENT</p><h1>Purchases</h1><p>Supplier stock receipts, payments and returns.</p></div><a href="/purchases/new" class="mt-btn mt-btn-primary mt-btn-lg">Receive stock</a></div><article class="mt-panel mt-panel-flush"><div class="mt-table-wrap"><table class="mt-table"><thead><tr><th>Purchase</th><th>Date</th><th>Supplier</th><th>Total</th><th>Payment</th><th>Status</th><th></th></tr></thead><tbody>{{#each purchases}}<tr><td><strong>{{purchase_number}}</strong></td><td>{{dateTime purchase_date}}</td><td>{{#if supplier}}{{supplier}}{{else}}—{{/if}}</td><td><strong>TZS {{money total}}</strong></td><td>{{payment_status}}</td><td><span class="mt-status mt-status-success">{{status}}</span></td><td><a class="mt-action-link" href="/purchases/{{id}}">View</a></td></tr>{{else}}<tr><td colspan="7"><div class="mt-empty-state">No purchases yet.</div></td></tr>{{/each}}</tbody></table></div></article></section>