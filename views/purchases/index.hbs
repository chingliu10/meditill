<section class="mt-page">
  <div class="mt-page-header">
    <div><p class="mt-eyebrow">PROCUREMENT</p><h1>Purchases</h1><p>Supplier stock receipts, payments and returns.</p></div>
    <a href="/purchases/new" class="mt-btn mt-btn-primary mt-btn-lg">Receive stock</a>
  </div>

  <div class="mt-sales-filterbar">
    <div class="mt-period-strip" aria-label="Purchase period">
      {{#each periods}}<a href="{{url}}" class="mt-period-chip {{#if active}}is-active{{/if}}">{{label}}</a>{{/each}}
    </div>
    <form class="mt-sales-search" method="get">
      <input type="hidden" name="period" value="{{period}}">
      <input name="q" value="{{q}}" placeholder="Search purchase, invoice or supplier">
      {{#if q}}<a href="/purchases?period={{period}}" class="mt-search-clear" aria-label="Clear search">×</a>{{/if}}
      <button class="mt-btn mt-btn-primary">Search</button>
    </form>
  </div>

  <article class="mt-panel mt-panel-flush">
    <div class="mt-table-wrap">
      <table class="mt-table">
        <thead><tr><th>Purchase</th><th>Date</th><th>Supplier</th><th>Total</th><th>Payment</th><th>Status</th><th></th></tr></thead>
        <tbody>
          {{#each purchases}}
          <tr>
            <td><strong>{{purchase_number}}</strong></td>
            <td>{{dateTime purchase_date}}</td>
            <td>{{#if supplier}}{{supplier}}{{else}}—{{/if}}</td>
            <td><strong>TZS {{money total}}</strong></td>
            <td>{{payment_status}}</td>
            <td><span class="mt-status mt-status-success">{{status}}</span></td>
            <td><a class="mt-action-link" href="/purchases/{{id}}">View</a></td>
          </tr>
          {{else}}
          <tr><td colspan="7"><div class="mt-empty-state">No purchases found for this period.</div></td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <div class="mt-pagination-bar">
      <div class="mt-pagination-summary">{{#if pagination.totalRows}}Showing <strong>{{pagination.firstRow}}–{{pagination.lastRow}}</strong> of <strong>{{pagination.totalRows}}</strong>{{else}}0 purchases{{/if}}</div>
      <nav class="mt-pagination">
        {{#if pagination.hasPrevious}}<a class="mt-page-link" href="{{pagination.previousUrl}}">‹ Previous</a>{{else}}<span class="mt-page-link is-disabled">‹ Previous</span>{{/if}}
        {{#each pagination.pageLinks}}<a class="mt-page-link mt-page-number {{#if active}}is-active{{/if}}" href="{{url}}">{{value}}</a>{{/each}}
        {{#if pagination.hasNext}}<a class="mt-page-link" href="{{pagination.nextUrl}}">Next ›</a>{{else}}<span class="mt-page-link is-disabled">Next ›</span>{{/if}}
      </nav>
      <div class="mt-pagination-page">Page {{pagination.page}} of {{pagination.totalPages}} · 25 rows</div>
    </div>
  </article>
</section>
