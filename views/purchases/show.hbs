<section class="mt-page"><div class="mt-page-header"><div><p class="mt-eyebrow">PURCHASE</p><h1>{{purchase.purchase_number}}</h1><p>{{purchase.supplier}} · {{dateTime purchase.purchase_date}}</p></div><a href="/purchases" class="mt-btn mt-btn-secondary">Back</a></div><div class="mt-sale-summary"><article class="mt-panel mt-panel-body"><span>Net purchase</span><strong>TZS {{money netTotal}}</strong></article><article class="mt-panel mt-panel-body"><span>Returned</span><strong>TZS {{money returned}}</strong></article><article class="mt-panel mt-panel-body"><span>Paid</span><strong>TZS {{money paid}}</strong></article><article class="mt-panel mt-panel-body"><span>Balance</span><strong>TZS {{money balance}}</strong></article></div><article class="mt-panel mt-panel-flush"><div class="mt-table-wrap"><table class="mt-table"><thead><tr><th>Medicine</th><th>Batch</th><th>Expiry</th><th>Received</th><th>Available</th><th>Cost</th></tr></thead><tbody>{{#each items}}<tr><td><strong>{{name}} {{strength}}</strong></td><td>{{batch_number}}</td><td>{{date expiry_date}}</td><td>{{quantity quantity}}</td><td>{{quantity quantity_available}}</td><td>TZS {{money unit_cost}}</td></tr>{{/each}}</tbody></table></div></article><div class="mt-two-column"><article class="mt-panel mt-form-panel"><div class="mt-panel-header"><div><h2>Record supplier payment</h2><p>Status: {{purchase.payment_status}}</p></div></div><form method="post" action="/purchases/{{purchase.id}}/payments" class="mt-panel-body mt-form-stack"><label>Amount<input type="number" min="0.01" step="0.01" max="{{balance}}" name="amount" required></label><label>Method<select name="payment_method"><option>CASH</option><option>MOBILE_MONEY</option><option>CARD</option><option>BANK</option></select></label><label>Reference<input name="reference"></label><button class="mt-btn mt-btn-primary">Record payment</button></form><div class="mt-list">{{#each payments}}<div class="mt-risk-row"><span><strong>{{payment_method}}</strong><small>{{dateTime created_at}} · {{reference}}</small></span><strong>TZS {{money amount}}</strong></div>{{/each}}</div></article><article class="mt-panel mt-form-panel"><div class="mt-panel-header"><div><h2>Return to supplier</h2><p>Deducts the selected batch from stock and reduces the payable.</p></div></div><form method="post" action="/purchases/{{purchase.id}}/returns" class="mt-panel-body mt-form-stack">{{#each items}}<div class="mt-return-row"><input type="hidden" name="items[{{@index}}][purchase_item_id]" value="{{id}}"><input type="hidden" name="items[{{@index}}][batch_id]" value="{{batch_id}}"><span><strong>{{name}} · {{batch_number}}</strong><small>Available {{quantity quantity_available}}</small></span><input type="number" min="0" max="{{quantity_available}}" step="0.0001" value="0" name="items[{{@index}}][quantity]"></div>{{/each}}<label>Reason<input name="reason" required></label><button class="mt-btn mt-btn-danger">Post purchase return</button></form>{{#if returns}}<div class="mt-list">{{#each returns}}<div class="mt-risk-row"><span><strong>{{return_number}}</strong><small>{{reason}}</small></span><strong>TZS {{money total_value}}</strong></div>{{/each}}</div>{{/if}}</article></div></section>