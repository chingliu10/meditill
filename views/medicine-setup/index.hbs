<section class="mt-page"><div class="mt-page-header"><div><p class="mt-eyebrow">MEDICINE MASTER DATA</p><h1>Medicine setup</h1><p>Archive master data instead of deleting values that may already be referenced by medicines.</p></div><a href="/medicines" class="mt-btn mt-btn-secondary">Medicines</a></div>
<div class="mt-three-column">
<article class="mt-panel"><div class="mt-panel-header"><div><h2>Categories</h2></div></div><div class="mt-list">{{#each categories}}<div class="mt-risk-row"><strong>{{name}}</strong><div class="mt-row-actions"><span class="mt-status {{#if active}}mt-status-success{{else}}mt-status-danger{{/if}}">{{#if active}}Active{{else}}Archived{{/if}}</span><form method="post" action="/medicine-setup/category/{{id}}/active" data-confirm-form data-confirm-title="{{#if active}}Archive category?{{else}}Restore category?{{/if}}" data-confirm-message="Existing medicines keep their category reference."><input type="hidden" name="active" value="{{#if active}}false{{else}}true{{/if}}"><button class="mt-btn mt-btn-xs {{#if active}}mt-btn-ghost-danger{{else}}mt-btn-ghost-success{{/if}}">{{#if active}}Archive{{else}}Restore{{/if}}</button></form></div></div>{{/each}}</div><form method="post" action="/medicine-setup/categories" class="mt-panel-body mt-form-stack"><label>New category<input name="name" required></label><button class="mt-btn mt-btn-secondary">Add category</button></form></article>
<article class="mt-panel"><div class="mt-panel-header"><div><h2>Manufacturers</h2></div></div><div class="mt-list">{{#each manufacturers}}<div class="mt-risk-row"><span><strong>{{name}}</strong><small>{{country}}</small></span><div class="mt-row-actions"><span class="mt-status {{#if active}}mt-status-success{{else}}mt-status-danger{{/if}}">{{#if active}}Active{{else}}Archived{{/if}}</span><form method="post" action="/medicine-setup/manufacturer/{{id}}/active" data-confirm-form data-confirm-title="{{#if active}}Archive manufacturer?{{else}}Restore manufacturer?{{/if}}" data-confirm-message="Existing medicines remain linked for historical accuracy."><input type="hidden" name="active" value="{{#if active}}false{{else}}true{{/if}}"><button class="mt-btn mt-btn-xs {{#if active}}mt-btn-ghost-danger{{else}}mt-btn-ghost-success{{/if}}">{{#if active}}Archive{{else}}Restore{{/if}}</button></form></div></div>{{else}}<div class="mt-empty-state">No manufacturers.</div>{{/each}}</div><form method="post" action="/medicine-setup/manufacturers" class="mt-panel-body mt-form-stack"><label>Name<input name="name" required></label><label>Country<input name="country"></label><button class="mt-btn mt-btn-secondary">Add manufacturer</button></form></article>
<article class="mt-panel"><div class="mt-panel-header"><div><h2>Units</h2></div></div><div class="mt-list">{{#each units}}<div class="mt-risk-row"><span><strong>{{name}}</strong><small>{{symbol}} · {{#if allow_fraction}}Decimal{{else}}Whole{{/if}}</small></span><div class="mt-row-actions"><span class="mt-status {{#if active}}mt-status-success{{else}}mt-status-danger{{/if}}">{{#if active}}Active{{else}}Archived{{/if}}</span><form method="post" action="/medicine-setup/unit/{{id}}/active" data-confirm-form data-confirm-title="{{#if active}}Archive unit?{{else}}Restore unit?{{/if}}" data-confirm-message="Medicines already using this unit keep their reference."><input type="hidden" name="active" value="{{#if active}}false{{else}}true{{/if}}"><button class="mt-btn mt-btn-xs {{#if active}}mt-btn-ghost-danger{{else}}mt-btn-ghost-success{{/if}}">{{#if active}}Archive{{else}}Restore{{/if}}</button></form></div></div>{{/each}}</div><form method="post" action="/medicine-setup/units" class="mt-panel-body mt-form-stack"><label>Name<input name="name" required></label><label>Symbol<input name="symbol"></label><label class="mt-check"><input type="checkbox" name="allow_fraction"><span>Allow fractional quantity</span></label><button class="mt-btn mt-btn-secondary">Add unit</button></form></article>
</div></section>