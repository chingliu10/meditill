<section class="mt-page"><div class="mt-page-header"><div><p class="mt-eyebrow">MEDICINE MASTER DATA</p><h1>Medicine setup</h1><p>Categories, manufacturers and stock units used by medicine records.</p></div><a href="/medicines" class="mt-btn mt-btn-secondary">Medicines</a></div><div class="mt-three-column"><article class="mt-panel"><div class="mt-panel-header"><div><h2>Categories</h2></div></div><div class="mt-list">{{#each categories}}<div class="mt-risk-row"><strong>{{name}}</strong><span class="mt-status mt-status-success">Active</span></div>{{/each}}</div><form method="post" action="/medicine-setup/categories" class="mt-panel-body mt-form-stack"><label>New category<input name="name" required></label><button class="mt-btn mt-btn-secondary">Add category</button></form></article><article class="mt-panel"><div class="mt-panel-header"><div><h2>Manufacturers</h2></div></div><div class="mt-list">{{#each manufacturers}}<div class="mt-risk-row"><span><strong>{{name}}</strong><small>{{country}}</small></span></div>{{else}}<div class="mt-empty-state">No manufacturers.</div>{{/each}}</div><form method="post" action="/medicine-setup/manufacturers" class="mt-panel-body mt-form-stack"><label>Name<input name="name" required></label><label>Country<input name="country"></label><button class="mt-btn mt-btn-secondary">Add manufacturer</button></form></article><article class="mt-panel"><div class="mt-panel-header"><div><h2>Units</h2></div></div><div class="mt-list">{{#each units}}<div class="mt-risk-row"><span><strong>{{name}}</strong><small>{{symbol}}</small></span><span class="mt-status mt-status-info">{{#if allow_fraction}}Decimal{{else}}Whole{{/if}}</span></div>{{/each}}</div><form method="post" action="/medicine-setup/units" class="mt-panel-body mt-form-stack"><label>Name<input name="name" required></label><label>Symbol<input name="symbol"></label><label class="mt-check"><input type="checkbox" name="allow_fraction"><span>Allow fractional quantity</span></label><button class="mt-btn mt-btn-secondary">Add unit</button></form></article></div></section>