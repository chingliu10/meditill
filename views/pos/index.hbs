<div class="pos-shell row g-3">
<div class="col-lg-7 pos-products"><div class="d-flex justify-content-between align-items-center mb-2"><h2 class="mb-0">POS</h2>{{#if register}}<span class="badge text-bg-success">Register open</span>{{else}}<a href="/registers" class="btn btn-warning">Open register</a>{{/if}}</div>
<input id="scanInput" class="form-control form-control-lg mb-3" autocomplete="off" placeholder="Scan barcode or search medicine" autofocus>
<div id="products" class="row g-2"></div></div>
<div class="col-lg-5 pos-cart"><div class="card h-100 p-3"><h4>Cart</h4><div id="cartLines" class="flex-grow-1"></div><hr>
<div class="d-flex justify-content-between"><span>Subtotal</span><strong id="subtotal">TZS 0</strong></div>
<div class="d-flex justify-content-between fs-4 mt-2"><span>Total</span><strong id="total">TZS 0</strong></div>
<div class="mt-3"><label class="form-label">Payment</label><div class="input-group"><select id="paymentMethod" class="form-select"><option>CASH</option><option>MOBILE_MONEY</option><option>CARD</option><option>BANK</option></select><input id="paymentAmount" type="number" class="form-control" min="0" step="0.01"></div></div>
<button id="completeSale" class="btn btn-primary btn-lg touch-btn mt-3" {{#unless register}}disabled{{/unless}}>Complete sale</button>
<div id="posMessage" class="mt-2"></div></div></div></div>
<script src="/js/pos.js"></script>