<section class="mt-pos mt-pos-fullscreen">
  <div class="mt-pos-grid">
    <aside class="mt-pos-cart" id="posCart">
      <div class="mt-cart-heading">
        <div>
          <h2>Current sale</h2>
          <span id="cartCount">0 items</span>
        </div>
        <button type="button" id="mobileCartClose" class="mt-mobile-cart-close" aria-label="Close cart">×</button>
      </div>

      <div class="mt-customer-picker">
        <label for="customerSearch">Customer</label>
        <input type="hidden" id="customerId">
        <input id="customerSearch" autocomplete="off" placeholder="Walk-in Customer">
        <div id="customerResults" class="mt-picker-menu"></div>
      </div>

      <div class="mt-receipt-columns"><span>Medicine / quantity</span><span>Amount</span></div>
      <div id="posDraftNotice" class="mt-draft-notice" hidden role="status">
        <span id="posDraftMessage"></span>
        <div><a href="/sales" id="posReviewSales" hidden>Review sales</a><button type="button" id="posDraftRetry">Retry</button><button type="button" id="posDraftDiscard">Discard</button></div>
      </div>
      <div id="cartLines" class="mt-cart-lines" aria-live="polite">
        <div class="mt-empty-state">No items</div>
      </div>

      <div class="mt-cart-summary">
        <div><span>Subtotal</span><strong id="subtotal">TZS 0</strong></div>
      </div>
      <button type="button" id="posClearCart" class="mt-clear-sale" disabled><img src="/images/trash-2.svg" alt="" width="18" height="18">Clear sale</button>
    </aside>

    <section class="mt-pos-catalog" aria-label="Medicines">
      <div class="mt-pos-search-row">
        <div class="mt-pos-search">
          <span aria-hidden="true">⌕</span>
          <input id="scanInput" aria-label="Scan barcode or search medicine" autocomplete="off" placeholder="Scan barcode or search medicine" autofocus>
        </div>
        <button type="button" id="posClearSearch" class="mt-pos-search-clear" aria-label="Clear search" title="Clear search">&times;</button>
      </div>
      <div class="mt-catalog-toolbar">
        <strong id="posProductCount" aria-live="polite">Medicines</strong>
        <label class="mt-stock-filter"><input type="checkbox" id="inStockOnly">In stock only</label>
      </div>
      <select id="posCategories" class="mt-category-select" aria-label="Medicine category"><option value="">All medicines</option></select>
      <div id="products" class="mt-product-grid" aria-label="Medicine results"></div>
      <nav class="mt-catalog-pages" aria-label="Medicine pages"><button type="button" id="posPreviousPage" title="Previous page" aria-label="Previous page" disabled>&larr;</button><span id="posPageCount">Page 1</span><button type="button" id="posNextPage" title="Next page" aria-label="Next page" disabled>&rarr;</button></nav>
    </section>

    <aside class="mt-pos-payment" id="posPayment" aria-label="Payment">
      <div class="mt-payment-total"><span>Amount due</span><strong id="total">TZS 0</strong><small id="paymentItemCount">0 items</small></div>
      <div class="mt-payment-box">
        <label>Payment method</label>
        <div class="mt-payment-methods">
          <button type="button" data-method="CASH" class="is-active" aria-pressed="true">Cash</button>
          <button type="button" data-method="MOBILE_MONEY" aria-pressed="false">Mobile</button>
          <button type="button" data-method="CARD" aria-pressed="false">Card</button>
          <button type="button" data-method="BANK" aria-pressed="false">Bank</button>
        </div>
        <input type="hidden" id="paymentMethod" value="CASH">

        <label for="paymentAmount">Amount received</label>
        <input id="paymentAmount" type="text" inputmode="decimal" maxlength="12" autocomplete="off">
        <div class="mt-cash-presets" aria-label="Payment amounts">
          <button type="button" id="posExactAmount">Exact</button>
          <button type="button" data-cash-amount="5000">5,000</button>
          <button type="button" data-cash-amount="10000">10,000</button>
        </div>
        <div class="mt-payment-keypad" role="group" aria-label="Payment keypad">
          <button type="button" data-pay-key="7">7</button><button type="button" data-pay-key="8">8</button><button type="button" data-pay-key="9">9</button>
          <button type="button" data-pay-key="4">4</button><button type="button" data-pay-key="5">5</button><button type="button" data-pay-key="6">6</button>
          <button type="button" data-pay-key="1">1</button><button type="button" data-pay-key="2">2</button><button type="button" data-pay-key="3">3</button>
          <button type="button" data-pay-key=".">.</button><button type="button" data-pay-key="0">0</button>
          <button type="button" data-pay-key="backspace" aria-label="Backspace amount" title="Backspace amount"><img src="/images/backspace.svg" alt="" width="22" height="22"></button>
        </div>

        <div class="mt-pos-change-preview">
          <span id="posChangeLabel">Change</span>
          <strong id="changePreview">TZS 0</strong>
        </div>
      </div>

      <button id="completeSale" class="mt-btn mt-btn-primary mt-complete-sale" disabled>Complete sale</button>
    </aside>
  </div>
</section>

<div id="mobileCartBackdrop" class="mt-mobile-cart-backdrop" hidden></div>

<button type="button" id="mobileCartBar" class="mt-mobile-cart-bar" aria-label="Review cart">
  <span class="mt-mobile-cart-icon">🛒</span>
  <span class="mt-mobile-cart-copy">
    <strong id="mobileCartCount">0 items</strong>
    <small>Review cart</small>
  </span>
  <strong id="mobileCartTotal">TZS 0</strong>
  <span class="mt-mobile-cart-arrow">›</span>
</button>

<dialog class="mt-pos-dialog" id="saleSuccess" aria-labelledby="saleSuccessTitle">
  <div class="mt-sale-success-card">
    <button type="button" id="saleSuccessClose" class="mt-sale-success-close" aria-label="Close">×</button>
    <div class="mt-success-check">✓</div>
    <h2 id="saleSuccessTitle">Sale completed</h2>
    <p id="saleSuccessNumber"></p>
    <strong id="saleSuccessChange"></strong>
    <div class="mt-modal-actions">
      <a id="saleReceiptLink" target="_blank" class="mt-btn mt-btn-secondary">Print receipt</a>
      <button id="saleDone" class="mt-btn mt-btn-primary">New sale</button>
    </div>
  </div>
</dialog>

<dialog class="mt-pos-dialog" id="posRegisterCloseModal" aria-labelledby="posRegisterCloseTitle">
  <div class="mt-modal">
    <div class="mt-modal-icon">▣</div>
    <h3 id="posRegisterCloseTitle">Close register?</h3>
    <p>Count the physical cash in the drawer. Closing the register ends this cashier session.</p>
    <form id="posRegisterCloseForm" class="mt-form-stack">
      <label>Actual cash counted
        <input type="number" min="0" step="0.01" name="actual_cash" required autofocus>
      </label>
      <div class="mt-modal-actions">
        <button type="button" class="mt-btn mt-btn-secondary" id="posRegisterCloseCancel">Cancel</button>
        <button type="submit" class="mt-btn mt-btn-danger">Close register</button>
      </div>
    </form>
  </div>
</dialog>

<dialog class="mt-pos-dialog" id="posConfirm" aria-labelledby="posConfirmTitle" aria-describedby="posConfirmMessage"><div class="mt-modal"><h3 id="posConfirmTitle">Clear sale?</h3><p id="posConfirmMessage">Remove all items from this sale?</p><div class="mt-modal-actions"><button type="button" class="mt-btn mt-btn-secondary" id="posConfirmCancel" autofocus>Cancel</button><button type="button" class="mt-btn mt-btn-danger" id="posConfirmAccept">Clear sale</button></div></div></dialog>

<script src="/js/pos-state.js?v=20261007-4"></script>
<script src="/js/pos.js?v=20261007-6"></script>
