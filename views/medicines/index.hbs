<section class="mt-page"><div class="mt-page-header"><div><p class="mt-eyebrow">PRODUCT MANAGEMENT</p><h1>Medicines</h1><p>Manage medicine identity, barcode, pricing and branch stock visibility.</p></div><a class="mt-btn mt-btn-primary mt-btn-lg" href="/medicines/new">+ Add medicine</a></div><div class="mt-toolbar"><form class="mt-search-form" method="get"><span class="mt-search-icon">⌕</span><input name="q" value="{{q}}" placeholder="Search medicine, generic, brand, SKU or barcode">{{#if q}}<a href="/medicines" class="mt-search-clear">×</a>{{/if}}<button class="mt-btn mt-btn-primary">Search</button></form></div><article class="mt-panel mt-panel-flush"><div class="mt-table-wrap"><table class="mt-table mt-medicine-table"><thead><tr><th>Medicine</th><th>Category</th><th>Barcode</th><th>Stock</th><th>Price</th><th>Status</th><th></th></tr></thead><tbody>{{#each medicines}}<tr><td><div class="mt-medicine-cell"><img class="mt-medicine-thumb" src="{{#if image_path}}{{image_path}}{{else}}/images/default-medicine.svg{{/if}}" onerror="this.src='/images/default-medicine.svg'"><div><strong>{{name}} {{strength}}</strong><small>{{generic_name}}{{#if brand_name}} · {{brand_name}}{{/if}}</small></div></div></td><td>{{#if category}}{{category}}{{else}}—{{/if}}</td><td><span class="mt-code">{{#if barcode}}{{barcode}}{{else}}—{{/if}}</span></td><td><strong>{{quantity saleable_stock}}</strong><small class="mt-cell-sub">{{unit_name}}</small></td><td><strong>TZS {{money default_selling_price}}</strong></td><td><span class="mt-status mt-status-{{stockClass saleable_stock reorder_level}}">{{stockLabel saleable_stock reorder_level}}</span></td><td class="mt-text-right"><a class="mt-action-link" href="/medicines/{{id}}/edit">Edit</a></td></tr>{{else}}<tr><td colspan="7"><div class="mt-empty-state mt-empty-large"><img src="/images/default-medicine.svg"><strong>No medicines found</strong><span>Create a medicine or change your search.</span></div></td></tr>{{/each}}</tbody></table></div></article></section>