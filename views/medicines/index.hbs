<section class="mt-page">
  <div class="mt-page-header">
    <div><p class="mt-eyebrow">PRODUCT MANAGEMENT</p><h1>Medicines</h1><p>Manage medicine identity, barcode, pricing and branch stock visibility.</p></div>
    <a class="mt-btn mt-btn-primary mt-btn-lg" href="/medicines/new">+ Add medicine</a>
  </div>

  <div class="mt-toolbar">
    <form class="mt-search-form" method="get" data-debounce-search="350">
      <span class="mt-search-icon">⌕</span>
      <input name="q" value="{{q}}" placeholder="Search medicine, generic, brand, SKU or barcode">
      {{#if q}}<a href="/medicines" class="mt-search-clear">×</a>{{/if}}
      <button class="mt-btn mt-btn-primary">Search</button>
    </form>
    <span class="mt-toolbar-meta">25 medicines per page</span>
  </div>

  <article class="mt-panel mt-panel-flush">
    <div class="mt-table-wrap">
      <table class="mt-table mt-medicine-table">
        <thead><tr><th>Medicine</th><th>Category</th><th>Barcode</th><th>Stock</th><th>Price</th><th>Status</th><th></th></tr></thead>
        <tbody>
        {{#each medicines}}
          <tr>
            <td><div class="mt-medicine-cell"><img class="mt-medicine-thumb" src="{{#if image_path}}{{image_path}}{{else}}/images/default-medicine.svg{{/if}}" onerror="this.src='/images/default-medicine.svg'"><div><strong>{{name}} {{strength}}</strong><small>{{generic_name}}{{#if brand_name}} · {{brand_name}}{{/if}}</small></div></div></td>
            <td>{{#if category}}{{category}}{{else}}—{{/if}}</td>
            <td><span class="mt-code">{{#if barcode}}{{barcode}}{{else}}—{{/if}}</span></td>
            <td><strong>{{quantity saleable_stock}}</strong><small class="mt-cell-sub">{{unit_name}}</small></td>
            <td><strong>TZS {{money default_selling_price}}</strong></td>
            <td><span class="mt-status mt-status-{{stockClass saleable_stock reorder_level}}">{{stockLabel saleable_stock reorder_level}}</span></td>
            <td class="mt-text-right"><a class="mt-action-link" href="/medicines/{{id}}/edit">Edit</a></td>
          </tr>
        {{else}}
          <tr><td colspan="7"><div class="mt-empty-state mt-empty-large"><img src="/images/default-medicine.svg"><strong>No medicines found</strong><span>Create a medicine or change your search.</span></div></td></tr>
        {{/each}}
        </tbody>
      </table>
    </div>
    <div class="mt-pagination-bar">
      <div class="mt-pagination-summary">{{#if pagination.totalRows}}Showing <strong>{{pagination.firstRow}}–{{pagination.lastRow}}</strong> of <strong>{{pagination.totalRows}}</strong>{{else}}0 medicines{{/if}}</div>
      <nav class="mt-pagination">
        {{#if pagination.hasPrevious}}<a class="mt-page-link" href="{{pagination.previousUrl}}">‹ Previous</a>{{else}}<span class="mt-page-link is-disabled">‹ Previous</span>{{/if}}
        {{#each pagination.pageLinks}}<a class="mt-page-link mt-page-number {{#if active}}is-active{{/if}}" href="{{url}}">{{value}}</a>{{/each}}
        {{#if pagination.hasNext}}<a class="mt-page-link" href="{{pagination.nextUrl}}">Next ›</a>{{else}}<span class="mt-page-link is-disabled">Next ›</span>{{/if}}
      </nav>
      <div class="mt-pagination-page">Page {{pagination.page}} of {{pagination.totalPages}} · 25 rows</div>
    </div>
  </article>
</section>
