<section class="mt-page"><div class="mt-page-header"><div><p class="mt-eyebrow">PRODUCT MANAGEMENT</p><h1>Add medicine</h1><p>Keep creation fast; batch and expiry are captured when receiving stock.</p></div><a href="/medicines" class="mt-btn mt-btn-secondary">Back to list</a></div><form method="post" action="/medicines" class="mt-panel mt-panel-body mt-form-grid"><label>Medicine name *<input name="name" required autofocus></label><label>Generic name<input name="generic_name"></label><label>Brand<input name="brand_name"></label><label>Strength<input name="strength" placeholder="500 mg"></label><label>Dosage form<input name="dosage_form" placeholder="Tablet"></label><label>Primary barcode<input name="barcode" autocomplete="off"></label><label>Selling price<input type="number" min="0" step="0.01" name="selling_price"></label><label>Reorder level<input type="number" min="0" step="0.0001" name="reorder_level"></label><label>Category<select name="category_id"><option value="">—</option>{{#each categories}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label><label>Base unit<select name="base_unit_id"><option value="">—</option>{{#each units}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label><label>Manufacturer<select name="manufacturer_id"><option value="">—</option>{{#each manufacturers}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label><label>Image path / URL<input name="image_path"></label><details class="mt-details"><summary>More details</summary><div class="mt-form-grid"><label>SKU<input name="sku"></label><label class="mt-check"><input type="checkbox" name="prescription_required"><span>Prescription required</span></label><label class="mt-check"><input type="checkbox" name="track_expiry" checked><span>Track expiry by batch</span></label><label class="mt-full">Description<textarea name="description" rows="3"></textarea></label></div></details><div class="mt-full mt-form-actions"><button class="mt-btn mt-btn-primary mt-btn-lg">Save medicine</button></div></form></section>