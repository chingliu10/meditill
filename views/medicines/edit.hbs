<section class="mt-page"><div class="mt-page-header"><div><p class="mt-eyebrow">MEDICINE</p><h1>Edit {{medicine.name}}</h1><p>Identity, pricing, barcodes and selling packages.</p></div><form method="post" action="/medicines/{{medicine.id}}/deactivate" class="deactivate-form"><button class="mt-btn mt-btn-danger">Deactivate</button></form></div><div class="mt-two-column"><article class="mt-panel mt-form-panel"><div class="mt-panel-header"><div><h2>Medicine details</h2></div></div><form method="post" action="/medicines/{{medicine.id}}" class="mt-panel-body mt-form-stack"><label>Name<input name="name" value="{{medicine.name}}" required></label><label>Generic name<input name="generic_name" value="{{medicine.generic_name}}"></label><div class="mt-form-row"><label>Brand<input name="brand_name" value="{{medicine.brand_name}}"></label><label>Strength<input name="strength" value="{{medicine.strength}}"></label></div><div class="mt-form-row"><label>Dosage form<input name="dosage_form" value="{{medicine.dosage_form}}"></label><label>SKU<input name="sku" value="{{medicine.sku}}"></label></div><div class="mt-form-row"><label>Selling price<input type="number" min="0" step="0.01" name="selling_price" value="{{medicine.default_selling_price}}"></label><label>Reorder level<input type="number" min="0" step="0.0001" name="reorder_level" value="{{medicine.reorder_level}}"></label></div><label>Category<select name="category_id"><option value="">—</option>{{#each categories}}<option value="{{id}}" {{#if (eq id ../medicine.category_id)}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Base unit<select name="base_unit_id"><option value="">—</option>{{#each units}}<option value="{{id}}" {{#if (eq id ../medicine.base_unit_id)}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Manufacturer<select name="manufacturer_id"><option value="">—</option>{{#each manufacturers}}<option value="{{id}}" {{#if (eq id ../medicine.manufacturer_id)}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>Image path / URL<input name="image_path" value="{{medicine.image_path}}"></label><label>Description<textarea name="description">{{medicine.description}}</textarea></label><label class="mt-check"><input type="checkbox" name="prescription_required" {{#if medicine.prescription_required}}checked{{/if}}><span>Prescription required</span></label><label class="mt-check"><input type="checkbox" name="track_expiry" {{#if medicine.track_expiry}}checked{{/if}}><span>Track expiry by batch</span></label><button class="mt-btn mt-btn-primary">Save changes</button></form></article><div class="mt-stack"><article class="mt-panel"><div class="mt-panel-header"><div><h2>Barcodes</h2></div></div><div class="mt-list">{{#each barcodes}}<div class="mt-risk-row"><div><strong>{{barcode}}</strong><small>{{#if is_primary}}Primary barcode{{else}}{{barcode_type}}{{/if}}</small></div><form method="post" action="/medicines/{{../medicine.id}}/barcodes/{{id}}/remove"><button class="mt-action-btn">×</button></form></div>{{/each}}</div><form method="post" action="/medicines/{{medicine.id}}/barcodes" class="mt-panel-body mt-form-stack"><label>New barcode<input name="barcode" required></label><label class="mt-check"><input type="checkbox" name="is_primary"><span>Make primary</span></label><button class="mt-btn mt-btn-secondary">Add barcode</button></form></article><article class="mt-panel"><div class="mt-panel-header"><div><h2>Packages / conversions</h2><p>Example: Strip = 10 tablets, Box = 100 tablets.</p></div></div><div class="mt-list">{{#each packages}}<div class="mt-risk-row"><div><strong>{{name}}</strong><small>1 {{name}} = {{quantity conversion_to_base}} base units · {{barcode}}</small></div><div><strong>{{#if selling_price}}TZS {{money selling_price}}{{else}}Default{{/if}}</strong><form method="post" action="/medicines/{{../medicine.id}}/packages/{{id}}/remove"><button class="mt-action-btn">×</button></form></div></div>{{else}}<div class="mt-empty-state">No alternate packages configured.</div>{{/each}}</div><form method="post" action="/medicines/{{medicine.id}}/packages" class="mt-panel-body mt-form-stack"><label>Package name<input name="name" required></label><label>Conversion to base<input type="number" min="0.0001" step="0.0001" name="conversion_to_base" required></label><label>Package barcode<input name="barcode"></label><label>Selling price<input type="number" min="0" step="0.01" name="selling_price"></label><button class="mt-btn mt-btn-secondary">Add package</button></form></article></div></div></section><script>document.querySelector('.deactivate-form')?.addEventListener('submit',async e=>{e.preventDefault();if(await MediTillConfirm({title:'Deactivate medicine?',message:'This medicine will no longer appear in normal sales.'}))e.target.submit()});</script>