<section class="mt-page"><div class="mt-page-header"><div><p class="mt-eyebrow">ACCESS CONTROL</p><h1>Roles & permissions</h1><p>Create job roles from granular permissions.</p></div><a href="/users" class="mt-btn mt-btn-secondary">Users</a></div><div class="mt-two-column"><article class="mt-panel"><div class="mt-panel-header"><div><h2>Roles</h2></div></div><div class="mt-list">{{#each roles}}<div class="mt-role-row"><div><strong>{{name}}</strong><small>{{description}}</small></div><div class="mt-role-permissions">{{#each permissions}}<span>{{this}}</span>{{/each}}</div></div>{{/each}}</div></article><article class="mt-panel mt-form-panel"><div class="mt-panel-header"><div><h2>Create role</h2></div></div><form method="post" class="mt-panel-body mt-form-stack"><label>Role name<input name="name" required></label><label>Description<input name="description"></label><div><strong>Permissions</strong><div class="mt-permission-grid">{{#each permissions}}<label class="mt-check"><input type="checkbox" name="permission_ids" value="{{id}}"><span>{{code}}</span></label>{{/each}}</div></div><button class="mt-btn mt-btn-primary">Create role</button></form></article></div></section>