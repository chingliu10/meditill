<div class="row g-3"><div class="col-lg-8"><h2>Suppliers</h2><div class="card table-responsive"><table class="table mb-0"><thead><tr><th>Name</th><th>Phone</th><th>Email</th></tr></thead><tbody>{{#each suppliers}}<tr><td>{{name}}</td><td>{{phone}}</td><td>{{email}}</td></tr>{{else}}<tr><td colspan="3">No suppliers yet.</td></tr>{{/each}}</tbody></table></div></div>
<div class="col-lg-4"><div class="card p-3"><h5>Add supplier</h5><form method="post"><input class="form-control mb-2" name="name" placeholder="Supplier name" required><input class="form-control mb-2" name="contact_person" placeholder="Contact person"><input class="form-control mb-2" name="phone" placeholder="Phone"><input class="form-control mb-2" name="email" placeholder="Email"><button class="btn btn-primary w-100">Save</button></form></div></div></div>