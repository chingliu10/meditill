<section class="mt-page">
  <div class="mt-page-header">
    <div><p class="mt-eyebrow">CONTACTS</p><h1>Suppliers</h1><p>Archive suppliers without losing historical purchases or batch traceability.</p></div>
    <a class="mt-btn mt-btn-secondary" href="/suppliers{{#unless showArchived}}?archived=1{{/unless}}">{{#if showArchived}}Hide archived{{else}}Show archived{{/if}}</a>
  </div>

  <div class="mt-two-column">
    <article class="mt-panel">
      <div class="mt-panel-header"><div><h2>Supplier list</h2><p>25 suppliers per page</p></div></div>
      <div class="mt-panel-body">
        <form class="mt-search-form" method="get">
          {{#if showArchived}}<input type="hidden" name="archived" value="1">{{/if}}
          <span class="mt-search-icon">⌕</span>
          <input name="q" value="{{q}}" placeholder="Search name, contact, phone or email">
          {{#if q}}<a href="/suppliers{{#if showArchived}}?archived=1{{/if}}" class="mt-search-clear">×</a>{{/if}}
          <button class="mt-btn mt-btn-primary">Search</button>
        </form>
      </div>
      <div class="mt-table-wrap">
        <table class="mt-table mt-table-compact">
          <thead><tr><th>Name</th><th>Contact</th><th>Phone</th><th>Email</th><th>Status</th><th>Actions</th></tr></thead>
          <tbody>
          {{#each suppliers}}
            <tr>
              <td><strong>{{name}}</strong></td><td>{{#if contact_person}}{{contact_person}}{{else}}—{{/if}}</td><td>{{#if phone}}{{phone}}{{else}}—{{/if}}</td><td>{{#if email}}{{email}}{{else}}—{{/if}}</td>
              <td>{{#if active}}<span class="mt-status mt-status-success">Active</span>{{else}}<span class="mt-status mt-status-danger">Archived</span>{{/if}}</td>
              <td><div class="mt-row-actions">{{#if active}}<form class="mt-inline-form" method="post" action="/suppliers/{{id}}/archive" data-confirm-form data-confirm-title="Archive supplier?" data-confirm-message="The supplier will no longer appear when receiving new stock. Existing purchases remain intact."><button class="mt-btn mt-btn-xs mt-btn-ghost-danger">Archive</button></form>{{else}}<form class="mt-inline-form" method="post" action="/suppliers/{{id}}/restore"><button class="mt-btn mt-btn-xs mt-btn-ghost-success">Restore</button></form>{{/if}}</div></td>
            </tr>
          {{else}}<tr><td colspan="6"><div class="mt-empty-state">No suppliers found.</div></td></tr>{{/each}}
          </tbody>
        </table>
      </div>
      <div class="mt-pagination-bar">
        <div class="mt-pagination-summary">{{#if pagination.totalRows}}Showing <strong>{{pagination.firstRow}}–{{pagination.lastRow}}</strong> of <strong>{{pagination.totalRows}}</strong>{{else}}0 suppliers{{/if}}</div>
        <nav class="mt-pagination">
          {{#if pagination.hasPrevious}}<a class="mt-page-link" href="{{pagination.previousUrl}}">‹ Previous</a>{{else}}<span class="mt-page-link is-disabled">‹ Previous</span>{{/if}}
          {{#each pagination.pageLinks}}<a class="mt-page-link mt-page-number {{#if active}}is-active{{/if}}" href="{{url}}">{{value}}</a>{{/each}}
          {{#if pagination.hasNext}}<a class="mt-page-link" href="{{pagination.nextUrl}}">Next ›</a>{{else}}<span class="mt-page-link is-disabled">Next ›</span>{{/if}}
        </nav>
        <div class="mt-pagination-page">Page {{pagination.page}} of {{pagination.totalPages}} · 25 rows</div>
      </div>
    </article>

    <article class="mt-panel mt-form-panel">
      <div class="mt-panel-header"><div><h2>Add supplier</h2></div></div>
      <form method="post" class="mt-panel-body mt-form-stack">
        <label>Name<input name="name" required></label>
        <label>Contact person<input name="contact_person"></label>
        <label>Phone<input name="phone" inputmode="tel"></label>
        <label>Email<input type="email" name="email"></label>
        <button class="mt-btn mt-btn-primary">Save supplier</button>
      </form>
    </article>
  </div>
</section>
