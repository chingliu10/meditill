<section class="mt-page">
  <div class="mt-page-header">
    <div>
      <p class="mt-eyebrow">BUSINESS OVERVIEW</p>
      <h1>Welcome, {{user.name}}</h1>
      <p>Monitor the activity you are authorized to see at {{currentBranch.name}}.</p>
    </div>
    <div class="d-flex gap-2 align-items-end flex-wrap">
      <form method="get">
        <label class="d-flex flex-column gap-1">
          <small>Period</small>
          <select name="period" class="mt-branch-select" onchange="this.form.submit()">
            <option value="today" {{#if periodToday}}selected{{/if}}>Today</option>
            <option value="yesterday" {{#if periodYesterday}}selected{{/if}}>Yesterday</option>
            <option value="7d" {{#if period7d}}selected{{/if}}>Last 7 Days</option>
            <option value="30d" {{#if period30d}}selected{{/if}}>Last 30 Days</option>
            <option value="1y" {{#if period1y}}selected{{/if}}>Last 1 Year</option>
          </select>
        </label>
      </form>
      {{#if access.canSaleCreate}}<a href="/pos" class="mt-btn mt-btn-primary mt-btn-lg">Start selling</a>{{/if}}
    </div>
  </div>

  {{#if hasMetricCards}}
  <div class="mt-metric-grid">
    {{#if access.canSales}}
    <article class="mt-metric-card">
      <div class="mt-metric-icon mt-metric-icon-green">↗</div>
      <div>
        <span>Sales</span>
        <strong>TZS {{money data.sales_period}}</strong>
        <small>{{period.label}} · {{data.transactions_period}} transactions</small>
      </div>
    </article>
    {{/if}}

    {{#if access.canProfit}}
    <article class="mt-metric-card">
      <div class="mt-metric-icon mt-metric-icon-blue">+</div>
      <div>
        <span>Gross profit</span>
        <strong>TZS {{money data.gross_profit_period}}</strong>
        <small>{{period.label}} · based on actual batch cost</small>
      </div>
    </article>
    {{/if}}

    {{#if access.canPurchases}}
    <article class="mt-metric-card">
      <div class="mt-metric-icon mt-metric-icon-amber">↓</div>
      <div>
        <span>Purchases</span>
        <strong>TZS {{money data.purchases_period}}</strong>
        <small>{{period.label}} · received stock value</small>
      </div>
    </article>
    {{/if}}

    {{#if access.canSales}}
    <article class="mt-metric-card">
      <div class="mt-metric-icon mt-metric-icon-purple">#</div>
      <div>
        <span>Transactions</span>
        <strong>{{data.transactions_period}}</strong>
        <small>{{period.label}}</small>
      </div>
    </article>
    {{/if}}
  </div>
  {{/if}}

  {{#if hasAlerts}}
  <div class="mt-alert-grid">
    {{#if access.canInventory}}
    <a href="/inventory" class="mt-alert-card mt-alert-warning">
      <span class="mt-alert-count">{{data.low_stock}}</span>
      <span><strong>Low stock</strong><small>Current · at or below reorder level</small></span>
      <b>→</b>
    </a>
    <a href="/inventory" class="mt-alert-card mt-alert-danger">
      <span class="mt-alert-count">{{data.out_of_stock}}</span>
      <span><strong>Out of stock</strong><small>Current · no saleable quantity</small></span>
      <b>→</b>
    </a>
    {{/if}}

    {{#if access.canExpiry}}
    <a href="/reports/expiry" class="mt-alert-card mt-alert-info">
      <span class="mt-alert-count">{{data.expiring_30}}</span>
      <span><strong>Expiring ≤30 days</strong><small>Current · needs attention soon</small></span>
      <b>→</b>
    </a>
    <a href="/reports/expiry" class="mt-alert-card mt-alert-danger-soft">
      <span class="mt-alert-count">{{data.expired_batches}}</span>
      <span><strong>Expired batches</strong><small>Current · remove from saleable stock</small></span>
      <b>→</b>
    </a>
    {{/if}}
  </div>
  {{/if}}

  {{#if hasInsights}}
  <div class="mt-dashboard-grid">
    {{#if access.canSalesReports}}
    <article class="mt-panel">
      <div class="mt-panel-header">
        <div>
          <h2>Top selling medicines</h2>
          <p>{{period.label}}</p>
        </div>
        <a href="/reports/sales">View report</a>
      </div>
      <div class="mt-list">
        {{#each topSelling}}
        <div class="mt-product-row">
          <img src="{{#if image_path}}{{image_path}}{{else}}/images/default-medicine.svg{{/if}}" alt="">
          <div class="mt-product-row-main">
            <strong>{{name}} {{strength}}</strong>
            <small>TZS {{money revenue}} revenue</small>
          </div>
          <span class="mt-pill mt-pill-success">Sold {{quantity quantity_sold}}</span>
        </div>
        {{else}}
        <div class="mt-empty-state">No sales found for this period.</div>
        {{/each}}
      </div>
    </article>
    {{/if}}

    {{#if access.canExpiry}}
    <article class="mt-panel">
      <div class="mt-panel-header">
        <div>
          <h2>Expiry risk</h2>
          <p>Current · next 90 days and expired</p>
        </div>
        <a href="/reports/expiry">Expiry report</a>
      </div>
      <div class="mt-list">
        {{#each expiryRisk}}
        <div class="mt-risk-row">
          <div>
            <strong>{{name}} {{strength}}</strong>
            <small>Batch {{batch_number}} · {{date expiry_date}}</small>
          </div>
          <div class="mt-risk-values">
            <span>{{quantity quantity_available}} left</span>
            <strong>TZS {{money value_at_risk}}</strong>
          </div>
        </div>
        {{else}}
        <div class="mt-empty-state">No near-expiry batches found.</div>
        {{/each}}
      </div>
    </article>
    {{/if}}
  </div>
  {{/if}}

  {{#if access.canSales}}
  <article class="mt-panel">
    <div class="mt-panel-header">
      <div>
        <h2>Recent sales</h2>
        <p>{{period.label}}</p>
      </div>
      {{#if access.canSalesReports}}<a href="/reports/sales">All sales</a>{{else}}<a href="/sales">All sales</a>{{/if}}
    </div>
    <div class="mt-table-wrap">
      <table class="mt-table">
        <thead>
          <tr><th>Sale</th><th>Date</th><th>Cashier</th><th class="mt-text-right">Amount</th></tr>
        </thead>
        <tbody>
          {{#each recentSales}}
          <tr>
            <td><strong>{{sale_number}}</strong></td>
            <td>{{dateTime created_at}}</td>
            <td>{{cashier}}</td>
            <td class="mt-text-right"><strong>TZS {{money total}}</strong></td>
          </tr>
          {{else}}
          <tr><td colspan="4"><div class="mt-empty-state">No sales found for this period.</div></td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </article>
  {{/if}}
</section>
