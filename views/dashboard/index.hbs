<div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="mb-0">Dashboard</h2><div class="text-muted">Today at {{currentBranch.name}}</div></div>
<form action="/branches/switch" method="post" class="d-flex gap-2"><select name="branch_id" class="form-select">{{#each branches}}<option value="{{id}}">{{name}}</option>{{/each}}</select><button class="btn btn-outline-secondary">Switch</button></form></div>
<div class="row g-3">
<div class="col-sm-6 col-xl-3"><div class="card p-3"><div class="text-muted">Sales today</div><h3>TZS {{money data.sales_today}}</h3></div></div>
<div class="col-sm-6 col-xl-3"><div class="card p-3"><div class="text-muted">Transactions</div><h3>{{data.transactions_today}}</h3></div></div>
<div class="col-sm-6 col-xl-3"><div class="card p-3"><div class="text-muted">Low stock</div><h3>{{data.low_stock}}</h3></div></div>
<div class="col-sm-6 col-xl-3"><div class="card p-3"><div class="text-muted">Expiring ≤30d</div><h3>{{data.expiring_30}}</h3></div></div>
</div>
<div class="mt-4"><a href="/pos" class="btn btn-primary btn-lg">Open POS</a></div>