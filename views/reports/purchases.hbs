<section class="mt-page">
  <div class="mt-report-nav">
    <a href="/reports/sales">Sales</a>
    <a href="/reports/inventory">Inventory</a>
    <a class="is-active" href="/reports/purchases">Purchases</a>
    <a href="/reports/expiry">Expiry</a>
    <a href="/reports/profit-loss">P&amp;L</a>
  </div>

  <div class="mt-page-header"><div><p class="mt-eyebrow">REPORTS</p><h1>Purchases</h1><p>Daily purchase totals for a bounded reporting period.</p></div></div>

  <div class="mt-sales-filterbar">
    <div class="mt-period-strip" aria-label="Purchase report period">
      {{#each periods}}<a href="{{url}}" class="mt-period-chip {{#if active}}is-active{{/if}}" data-ajax-target="report-purchases">{{label}}</a>{{/each}}
    </div>
  </div>

  <article class="mt-panel mt-panel-flush" data-ajax-results="report-purchases">
    <div class="mt-table-wrap">
      <table class="mt-table">
        <thead><tr><th>Date</th><th>Purchases</th><th>Total</th></tr></thead>
        <tbody>
          {{#each rows}}
          <tr><td>{{date purchase_date}}</td><td>{{purchases}}</td><td><strong>TZS {{money total}}</strong></td></tr>
          {{else}}
          <tr><td colspan="3"><div class="mt-empty-state">No purchases for this period.</div></td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </article>
</section>
