<section class="mt-page">
  <div class="mt-report-nav">
    <a href="/reports/sales">Sales</a>
    <a href="/reports/inventory">Inventory</a>
    <a href="/reports/purchases">Purchases</a>
    <a href="/reports/expiry">Expiry</a>
    <a class="is-active" href="/reports/profit-loss">P&amp;L</a>
  </div>

  <div class="mt-page-header">
    <div>
      <p class="mt-eyebrow">REPORTS</p>
      <h1>Operational Profit &amp; Loss</h1>
      <p>Net sales, historical batch cost and recorded operating expenses for {{currentBranch.name}}.</p>
    </div>
    <form method="get">
      <label class="d-flex flex-column gap-1">
        <small>Period</small>
        <select name="period" class="mt-branch-select" onchange="this.form.submit()">
          <option value="today" {{#if periodToday}}selected{{/if}}>Today</option>
          <option value="yesterday" {{#if periodYesterday}}selected{{/if}}>Yesterday</option>
          <option value="7d" {{#if period7d}}selected{{/if}}>Last 7 Days</option>
          <option value="30d" {{#if period30d}}selected{{/if}}>Last 30 Days</option>
          <option value="1y" {{#if period1y}}selected{{/if}}>Last 1 Year</option>
        </select>
      </label>
    </form>
  </div>

  <div class="mt-metric-grid">
    <article class="mt-metric-card"><div><span>Net sales</span><strong>TZS {{money summary.revenue}}</strong><small>{{period.label}}</small></div></article>
    <article class="mt-metric-card"><div><span>Gross profit</span><strong>TZS {{money summary.gross_profit}}</strong><small>{{summary.gross_margin}}% gross margin</small></div></article>
    <article class="mt-metric-card"><div><span>Operating expenses</span><strong>TZS {{money summary.operating_expenses}}</strong><small>{{period.label}}</small></div></article>
    <article class="mt-metric-card"><div><span>Net profit / loss</span><strong>TZS {{money summary.net_profit}}</strong><small>{{summary.net_margin}}% net margin</small></div></article>
  </div>

  <article class="mt-panel">
    <div class="mt-panel-header">
      <div>
        <h2>Profit &amp; Loss statement</h2>
        <p>{{period.label}}</p>
      </div>
    </div>
    <div class="mt-table-wrap">
      <table class="mt-table">
        <tbody>
          <tr><td><strong>Net sales</strong></td><td class="mt-text-right"><strong>TZS {{money summary.revenue}}</strong></td></tr>
          <tr><td>Cost of goods sold</td><td class="mt-text-right">TZS {{money summary.cost}}</td></tr>
          <tr><td><strong>Gross profit</strong></td><td class="mt-text-right"><strong>TZS {{money summary.gross_profit}}</strong></td></tr>
          <tr><td>Operating expenses</td><td class="mt-text-right">TZS {{money summary.operating_expenses}}</td></tr>
          <tr><td><strong>Net profit / loss</strong></td><td class="mt-text-right"><strong>TZS {{money summary.net_profit}}</strong></td></tr>
        </tbody>
      </table>
    </div>
  </article>

  <article class="mt-panel">
    <div class="mt-panel-header">
      <div>
        <h2>Operating expense breakdown</h2>
        <p>Expenses recorded in MediTill for {{period.label}}</p>
      </div>
    </div>
    <div class="mt-table-wrap">
      <table class="mt-table">
        <thead><tr><th>Category</th><th>Entries</th><th class="mt-text-right">Amount</th></tr></thead>
        <tbody>
          {{#each expenseCategories}}
          <tr><td><strong>{{category}}</strong></td><td>{{entries}}</td><td class="mt-text-right"><strong>TZS {{money total}}</strong></td></tr>
          {{else}}
          <tr><td colspan="3"><div class="mt-empty-state">No operating expenses recorded for this period.</div></td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </article>

  <p class="mt-cell-sub">Operational P&amp;L only. A future accounting module can extend this into a ledger-based financial statement with accruals, payroll, depreciation, interest, tax and other accounting adjustments.</p>
</section>
