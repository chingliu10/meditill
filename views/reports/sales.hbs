<section class="mt-page">
  <div class="mt-report-nav">
    <a class="is-active" href="/reports/sales">Sales</a>
    <a href="/reports/inventory">Inventory</a>
    <a href="/reports/purchases">Purchases</a>
    <a href="/reports/expiry">Expiry</a>
  </div>

  <div class="mt-page-header">
    <div>
      <p class="mt-eyebrow">REPORTS</p>
      <h1>Sales & profit</h1>
      <p>Net revenue and historical batch cost for the selected period.</p>
    </div>
  </div>

  <div class="mt-toolbar">
    <form class="mt-filter-form">
      <label>From<input type="date" name="from" value="{{from}}"></label>
      <label>To<input type="date" name="to" value="{{to}}"></label>
      <button class="mt-btn mt-btn-primary">Apply</button>
    </form>
  </div>

  <div class="mt-metric-grid">
    <article class="mt-metric-card"><div><span>Net revenue</span><strong>TZS {{money summary.revenue}}</strong></div></article>
    <article class="mt-metric-card"><div><span>Net cost</span><strong>TZS {{money summary.cost}}</strong></div></article>
    <article class="mt-metric-card"><div><span>Gross profit</span><strong>TZS {{money summary.gross_profit}}</strong></div></article>
    <article class="mt-metric-card"><div><span>Transactions</span><strong>{{summary.transactions}}</strong></div></article>
  </div>

  <article class="mt-panel mt-panel-flush">
    <div class="mt-table-wrap">
      <table class="mt-table">
        <thead><tr><th>Date</th><th>Transactions</th><th>Net revenue</th></tr></thead>
        <tbody>
          {{#each days}}
          <tr><td>{{date sale_date}}</td><td>{{transactions}}</td><td><strong>TZS {{money revenue}}</strong></td></tr>
          {{else}}
          <tr><td colspan="3"><div class="mt-empty-state">No sales for this period.</div></td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </article>
</section>
