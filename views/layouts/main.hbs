<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#0f766e">
  <link rel="manifest" href="/manifest.webmanifest">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <title>{{title}} | MediTill</title>
</head>
<body>
<nav class="navbar navbar-dark" style="background:#0f766e">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">MediTill</a>
    {{#if user}}
      <div class="text-white small">{{user.name}} {{#if currentBranch}}· {{currentBranch.name}}{{/if}} · <a class="text-white" href="/logout">Logout</a></div>
    {{/if}}
  </div>
</nav>
{{#if user}}
<div class="container-fluid"><div class="row">
  <aside class="col-lg-2 sidebar py-3">
    <nav class="nav flex-column">
      <a class="nav-link" href="/">Dashboard</a>
      <a class="nav-link fw-bold" href="/pos">POS</a>
      <a class="nav-link" href="/medicines">Medicines</a>
      <a class="nav-link" href="/purchases">Purchases</a>
      <a class="nav-link" href="/inventory">Inventory</a>
      <a class="nav-link" href="/suppliers">Suppliers</a>
      <a class="nav-link" href="/registers">Registers</a>
      <a class="nav-link" href="/reports/sales">Reports</a>
    </nav>
  </aside>
  <main class="col-lg-10 p-3 p-md-4">{{{body}}}</main>
</div></div>
{{else}}
<div class="container py-5">{{{body}}}</div>
{{/if}}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>if('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(()=>{});</script>
</body></html>
