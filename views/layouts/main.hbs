<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#0f7f76">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="MediTill">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/images/meditill-icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/images/meditill-icon.svg">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css?v=20261007-3">
  <title>{{title}} | MediTill</title>
</head>
<body>
<div id="toastHost" class="mt-toast-host" aria-live="polite" aria-atomic="true">{{#if flash}}<div class="mt-toast mt-toast-{{flash.type}}" data-server-toast><span class="mt-toast-icon"></span><span>{{flash.message}}</span><button type="button" class="mt-toast-close">×</button></div>{{/if}}</div>
{{#if user}}
<div class="mt-app">
<aside class="mt-sidebar" id="appSidebar">
  <div class="mt-brand"><a href="/" class="mt-brand-link"><span class="mt-brand-mark">M</span><span><strong>MediTill</strong><small>Pharmacy POS</small></span></a><button class="mt-icon-button mt-sidebar-close" id="closeSidebar" aria-label="Close menu">×</button></div>
  <nav class="mt-nav">
    <div class="mt-nav-section">OVERVIEW</div>
    <a class="mt-nav-link" data-nav href="/"><span class="mt-nav-icon">⌂</span><span>Dashboard</span></a>
    {{#if (can user "sale.create")}}<a class="mt-nav-link mt-nav-link-accent" data-nav href="/pos"><span class="mt-nav-icon">▦</span><span>POS</span></a>{{/if}}
    {{#if (can user "sale.view")}}<a class="mt-nav-link" data-nav href="/sales"><span class="mt-nav-icon">◫</span><span>Sales</span></a>{{/if}}

    {{#if (canAny user "medicine.view" "medicine.edit" "purchase.view" "inventory.view" "inventory.transfer" "inventory.stock_count")}}
    <div class="mt-nav-section">PHARMACY</div>
    {{/if}}
    {{#if (can user "medicine.view")}}<a class="mt-nav-link" data-nav href="/medicines"><span class="mt-nav-icon">✚</span><span>Medicines</span></a>{{/if}}
    {{#if (can user "medicine.edit")}}<a class="mt-nav-link" data-nav href="/medicine-setup"><span class="mt-nav-icon">◈</span><span>Medicine Setup</span></a>{{/if}}
    {{#if (can user "purchase.view")}}<a class="mt-nav-link" data-nav href="/purchases"><span class="mt-nav-icon">↓</span><span>Purchases</span></a>{{/if}}
    {{#if (can user "inventory.view")}}<a class="mt-nav-link" data-nav href="/inventory"><span class="mt-nav-icon">▤</span><span>Inventory</span></a>{{/if}}
    {{#if (can user "inventory.transfer")}}<a class="mt-nav-link" data-nav href="/transfers"><span class="mt-nav-icon">⇄</span><span>Transfers</span></a>{{/if}}
    {{#if (can user "inventory.stock_count")}}<a class="mt-nav-link" data-nav href="/stock-counts"><span class="mt-nav-icon">✓</span><span>Stock Counts</span></a>{{/if}}

    {{#if (canAny user "supplier.view" "customer.view" "register.open" "register.close" "branches.manage" "expense.view" "expense.create")}}
    <div class="mt-nav-section">CONTACTS & CASH</div>
    {{/if}}
    {{#if (can user "supplier.view")}}<a class="mt-nav-link" data-nav href="/suppliers"><span class="mt-nav-icon">♙</span><span>Suppliers</span></a>{{/if}}
    {{#if (can user "customer.view")}}<a class="mt-nav-link" data-nav href="/customers"><span class="mt-nav-icon">◎</span><span>Customers</span></a>{{/if}}
    {{#if (canAny user "register.open" "register.close" "branches.manage")}}<a class="mt-nav-link" data-nav href="/registers"><span class="mt-nav-icon">▣</span><span>Registers</span></a>{{/if}}
    {{#if (canAny user "expense.view" "expense.create")}}<a class="mt-nav-link" data-nav href="/expenses"><span class="mt-nav-icon">−</span><span>Expenses</span></a>{{/if}}

    {{#if (canAny user "reports.sales" "reports.profit" "reports.inventory" "reports.purchases" "branches.manage" "users.manage" "roles.manage" "settings.manage")}}
    <div class="mt-nav-section">MANAGEMENT</div>
    {{/if}}
    {{#if (canAny user "reports.sales" "reports.profit" "reports.inventory" "reports.purchases")}}<a class="mt-nav-link" data-nav href="{{reportHome user}}"><span class="mt-nav-icon">↗</span><span>Reports</span></a>{{/if}}
    {{#if (can user "branches.manage")}}<a class="mt-nav-link" data-nav href="/branches"><span class="mt-nav-icon">⌖</span><span>Branches</span></a>{{/if}}
    {{#if (can user "users.manage")}}<a class="mt-nav-link" data-nav href="/users"><span class="mt-nav-icon">♟</span><span>Users</span></a>{{/if}}
    {{#if (can user "roles.manage")}}<a class="mt-nav-link" data-nav href="/roles"><span class="mt-nav-icon">⚿</span><span>Roles</span></a>{{/if}}
    {{#if (can user "settings.manage")}}<a class="mt-nav-link" data-nav href="/settings"><span class="mt-nav-icon">⚙</span><span>Settings</span></a>{{/if}}
  </nav>
  <div class="mt-sidebar-footer"><a href="/profile" class="mt-sidebar-user mt-sidebar-user-link" title="Edit my profile"><span class="mt-avatar">●</span><div><strong>{{user.name}}</strong><small>{{currentBranch.name}}</small></div></a></div>
</aside>
<div class="mt-sidebar-backdrop" id="sidebarBackdrop"></div>
<div class="mt-workspace">
<header class="mt-topbar">
  <div class="mt-topbar-left"><button class="mt-icon-button mt-menu-button" id="openSidebar" aria-label="Open menu">☰</button><div class="mt-location"><span class="mt-location-label">Location</span><form action="/branches/switch" method="post" class="mt-branch-form"><select name="branch_id" class="mt-branch-select" onchange="this.form.submit()">{{#each branches}}<option value="{{id}}">{{name}}</option>{{/each}}</select></form></div></div>
  <div class="mt-topbar-actions">
    <button type="button" id="installApp" class="mt-install-app" hidden>Install app</button>
    {{#if (can user "sale.create")}}<a href="/pos" class="mt-topbar-pos">Open POS</a>{{/if}}
    <a href="/profile" class="mt-user-chip mt-user-chip-link" title="Edit my profile"><span class="mt-user-avatar">A</span><span class="mt-user-meta"><strong>{{user.name}}</strong><small>{{currentBranch.name}}</small></span></a>
    <a href="/logout" class="mt-topbar-logout">Logout</a>
  </div>
</header>
<main class="mt-content">{{{body}}}</main>
</div></div>
<nav class="mt-mobile-bottom-nav" aria-label="Mobile navigation">
  <a class="mt-mobile-nav-link" data-nav href="/"><span>⌂</span><span>Home</span></a>
  {{#if (can user "sale.create")}}<a class="mt-mobile-nav-link" data-nav href="/pos"><span>▦</span><span>POS</span></a>{{/if}}
  {{#if (can user "medicine.view")}}<a class="mt-mobile-nav-link" data-nav href="/medicines"><span>✚</span><span>Medicines</span></a>{{/if}}
  {{#if (can user "sale.view")}}<a class="mt-mobile-nav-link" data-nav href="/sales"><span>◫</span><span>Sales</span></a>{{/if}}
  <button class="mt-mobile-nav-link" type="button" id="mobileMore"><span>☰</span><span>More</span></button>
</nav>
{{else}}<main class="mt-auth-shell">{{{body}}}</main>{{/if}}
<div class="mt-modal-backdrop" id="confirmModal" hidden><div class="mt-modal"><div class="mt-modal-icon">!</div><h3 id="confirmTitle">Confirm action</h3><p id="confirmMessage">Are you sure?</p><div class="mt-modal-actions"><button class="mt-btn mt-btn-secondary" id="confirmCancel">Cancel</button><button class="mt-btn mt-btn-danger" id="confirmAccept">Confirm</button></div></div></div>
<script src="/js/pos-fullscreen.js?v=20261007-3"></script><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="/js/app.js?v=20261007-3"></script><script>if('serviceWorker' in navigator){navigator.serviceWorker.register('/sw.js').catch(error=>console.error('MediTill service worker registration failed',error));}</script>
</body></html>
