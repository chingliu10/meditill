<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#0f7f76">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="MediTill POS">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/images/meditill-icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/images/meditill-icon.svg">
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/pos.css?v=20261007-4">
  <script src="/js/pos-fullscreen.js?v=20261007-3"></script>
  <title>{{title}} | MediTill</title>
</head>
<body class="mt-pos-body mt-terminal" data-draft-scope="{{user.organization_id}}:{{user.id}}:{{currentBranch.id}}:{{register.id}}">
  <div id="toastHost" class="mt-toast-host" aria-live="polite" aria-atomic="true"></div>

  <header class="mt-pos-appbar">
    <a class="mt-pos-brand" href="/pos">
      <span class="mt-brand-mark">M</span>
      <span><strong>MediTill POS</strong><small>{{currentBranch.name}}</small></span>
    </a>

    <div class="mt-pos-appbar-session">
      <span class="mt-status mt-status-success">● {{register.register_name}}</span>
      <span>{{user.name}}</span>
    </div>

    <div class="mt-pos-appbar-actions">
      <button type="button" class="mt-pos-fullscreen-toggle" data-pos-fullscreen-toggle aria-label="Enter fullscreen" title="Enter fullscreen" aria-pressed="false" hidden><img src="/images/maximize.svg" alt="" width="20" height="20"></button>
      {{#if (canAny user "purchase.view" "inventory.view" "inventory.transfer" "inventory.stock_count" "reports.sales" "reports.profit" "reports.inventory" "reports.purchases" "users.manage" "roles.manage" "settings.manage" "branches.manage")}}
      <a href="/" class="mt-btn mt-btn-secondary">Back office</a>
      {{/if}}
      {{#if (can user "register.close")}}<button type="button" id="posCloseRegister" class="mt-btn mt-btn-danger" aria-label="Close register" title="Close register"><img src="/images/door-closed.svg" alt="" width="18" height="18"><span>Close register</span></button>{{/if}}
      <a href="/logout" class="mt-btn mt-btn-secondary">Logout</a>
    </div>
  </header>

  <main class="mt-pos-shell">{{{body}}}</main>

  <script src="/js/app.js"></script>
  <script>if('serviceWorker' in navigator){navigator.serviceWorker.register('/sw.js').catch(error=>console.error('MediTill service worker registration failed',error));}</script>
</body>
</html>
