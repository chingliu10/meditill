<section class="mt-page"><div class="mt-page-header"><div><p class="mt-eyebrow">STOCK COUNT</p><h1>{{count.count_number}}</h1><p>{{count.status}} · started {{dateTime count.started_at}}</p></div></div><form method="post" action="/stock-counts/{{count.id}}/complete"><article class="mt-panel mt-panel-flush"><div class="mt-table-wrap"><table class="mt-table"><thead><tr><th>Medicine</th><th>Batch</th><th>Expiry</th><th>System qty</th><th>Counted qty</th></tr></thead><tbody>{{#each items}}<tr><td><strong>{{name}} {{strength}}</strong><input type="hidden" name="items[{{@index}}][id]" value="{{id}}"></td><td>{{batch_number}}</td><td>{{date expiry_date}}</td><td>{{quantity system_quantity}}</td><td>{{#if ../count.completed_at}}{{quantity counted_quantity}}{{else}}<input class="mt-count-input" type="number" min="0" step="0.0001" name="items[{{@index}}][counted_quantity]" value="{{system_quantity}}" required>{{/if}}</td></tr>{{/each}}</tbody></table></div></article>{{#unless count.completed_at}}<div class="mt-form-actions"><button class="mt-btn mt-btn-primary mt-btn-lg">Complete count & post differences</button></div>{{/unless}}</form></section>