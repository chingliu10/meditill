<section class="mt-page"><div class="mt-page-header"><div><p class="mt-eyebrow">INVENTORY</p><h1>Physical stock counts</h1><p>Count batch-level stock and post audited corrections.</p></div><form method="post"><button class="mt-btn mt-btn-primary mt-btn-lg">Start new count</button></form></div><article class="mt-panel mt-panel-flush"><div class="mt-table-wrap"><table class="mt-table"><thead><tr><th>Count</th><th>Started</th><th>By</th><th>Status</th><th></th></tr></thead><tbody>{{#each counts}}<tr><td><strong>{{count_number}}</strong></td><td>{{dateTime started_at}}</td><td>{{started_by_name}}</td><td><span class="mt-status mt-status-info">{{status}}</span></td><td class="mt-text-right"><a class="mt-action-link" href="/stock-counts/{{id}}">Open</a></td></tr>{{else}}<tr><td colspan="5"><div class="mt-empty-state">No stock counts.</div></td></tr>{{/each}}</tbody></table></div></article></section>