<h2>Inventory</h2>
<div class="card table-responsive">
  <table class="table mb-0">
    <thead>
      <tr>
        <th>Medicine</th>
        <th>Stock</th>
        <th>Reorder</th>
        <th>Next expiry</th>
        <th>Value</th>
      </tr>
    </thead>
    <tbody>
      {{#each stock}}
      <tr>
        <td>
          <strong>{{name}}</strong>
          <div class="small text-muted">{{generic_name}} {{strength}}</div>
        </td>
        <td>{{quantity saleable_stock}}</td>
        <td>{{quantity reorder_level}}</td>
        <td>{{next_expiry}}</td>
        <td>TZS {{money stock_value}}</td>
      </tr>
      {{else}}
      <tr><td colspan="5">No stock.</td></tr>
      {{/each}}
    </tbody>
  </table>
</div>
