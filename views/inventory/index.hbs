<section class="mt-page">
<div class="mt-page-header"><div><p class="mt-eyebrow">INVENTORY</p><h1>Stock control</h1><p>Saleable stock, batches, expiry and controlled adjustments.</p></div><a href="/transfers" class="mt-btn mt-btn-secondary mt-btn-lg">Branch transfers</a></div>
<div class="mt-tabbar"><button class="mt-tab is-active" data-tab="stock">Stock summary</button><button class="mt-tab" data-tab="batches">Batches</button><button class="mt-tab" data-tab="adjust">Adjustment</button></div>
<div data-tab-panel="stock"><article class="mt-panel mt-panel-flush"><div class="mt-table-wrap"><table class="mt-table"><thead><tr><th>Medicine</th><th>Stock</th><th>Reorder</th><th>Next expiry</th><th>Value</th><th>Status</th></tr></thead><tbody>{{#each stock}}<tr><td><div class="mt-medicine-cell"><img class="mt-medicine-thumb" src="{{#if image_path}}{{image_path}}{{else}}/images/default-medicine.svg{{/if}}"><div><strong>{{name}} {{strength}}</strong><small>{{generic_name}}</small></div></div></td><td><strong>{{quantity saleable_stock}}</strong><small class="mt-cell-sub">{{unit_name}}</small></td><td>{{quantity reorder_level}}</td><td>{{date next_expiry}}</td><td>TZS {{money stock_value}}</td><td><span class="mt-status mt-status-{{stockClass saleable_stock reorder_level}}">{{stockLabel saleable_stock reorder_level}}</span></td></tr>{{else}}<tr><td colspan="6"><div class="mt-empty-state">No inventory.</div></td></tr>{{/each}}</tbody></table></div></article></div>
<div data-tab-panel="batches" hidden><div class="mt-toolbar"><form class="mt-search-form"><span class="mt-search-icon">⌕</span><input name="q" value="{{q}}" placeholder="Search medicine or batch"><button class="mt-btn mt-btn-primary">Search</button></form></div><article class="mt-panel mt-panel-flush"><div class="mt-table-wrap"><table class="mt-table"><thead><tr><th>Medicine</th><th>Batch</th><th>Expiry</th><th>Qty</th><th>Cost</th><th>Status</th><th>Control</th></tr></thead><tbody>{{#each batches}}<tr><td><strong>{{name}} {{strength}}</strong></td><td><span class="mt-code">{{batch_number}}</span></td><td>{{date expiry_date}}</td><td>{{quantity quantity_available}}</td><td>TZS {{money unit_cost}}</td><td><span class="mt-status mt-status-info">{{status}}</span></td><td><select class="mt-inline-select batch-status" data-batch="{{id}}"><option value="">Change...</option><option>SALEABLE</option><option>QUARANTINED</option><option>RECALLED</option><option>DAMAGED</option></select></td></tr>{{/each}}</tbody></table></div></article></div>
<div data-tab-panel="adjust" hidden><article class="mt-panel mt-form-panel mt-form-narrow"><div class="mt-panel-header"><div><h2>Stock adjustment</h2><p>All changes are written to the stock ledger.</p></div></div><form method="post" action="/inventory/adjustments" class="mt-panel-body mt-form-stack"><label>Batch<select name="batch_id" required><option value="">Select batch</option>{{#each batches}}<option value="{{id}}">{{name}} {{strength}} · {{batch_number}} · Qty {{quantity quantity_available}}</option>{{/each}}</select></label><label>Quantity change<input type="number" step="0.0001" name="quantity_change" placeholder="+5 or -2" required></label><label>Reason<select name="reason"><option>COUNT_CORRECTION</option><option>DAMAGE</option><option>FOUND_STOCK</option><option>DATA_CORRECTION</option></select></label><label>Notes<textarea name="notes" rows="3"></textarea></label><button class="mt-btn mt-btn-primary mt-btn-lg">Post adjustment</button></form></article></div>
</section>
<script>
document.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>{document.querySelectorAll('[data-tab]').forEach(x=>x.classList.toggle('is-active',x===b));document.querySelectorAll('[data-tab-panel]').forEach(p=>p.hidden=p.dataset.tabPanel!==b.dataset.tab)});
document.querySelectorAll('.batch-status').forEach(s=>s.onchange=async()=>{if(!s.value)return;const ok=await MediTillConfirm({title:'Change batch status?',message:'This affects whether the batch can be sold.'});if(!ok){s.value='';return}const r=await fetch('/inventory/batches/'+s.dataset.batch+'/status',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({status:s.value})});const j=await r.json();if(!r.ok)return MediTillToast(j.error||'Failed','error');MediTillToast('Batch status updated.');setTimeout(()=>location.reload(),500)});
</script>