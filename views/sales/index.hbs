<section class="mt-page">
  <div class="mt-page-header">
    <div>
      <p class="mt-eyebrow">SALES</p>
      <h1>Sales history</h1>
      <p>Completed pharmacy transactions and receipts.</p>
    </div>
    {{#if (can user "sale.create")}}<a href="/pos" class="mt-btn mt-btn-primary mt-btn-lg">New sale</a>{{/if}}
  </div>

  <div class="mt-sales-filterbar">
    <div class="mt-period-strip" aria-label="Sales period">
      {{#each periods}}
        <a href="{{url}}" class="mt-period-chip {{#if active}}is-active{{/if}}">{{label}}</a>
      {{/each}}
    </div>

    <form class="mt-sales-search" method="get" data-debounce-search="350">
      <input type="hidden" name="period" value="{{period}}">
      <input name="q" value="{{q}}" placeholder="Search sale number or customer">
      {{#if q}}<a href="/sales?period={{period}}" class="mt-search-clear" aria-label="Clear search">×</a>{{/if}}
      <button class="mt-btn mt-btn-primary">Search</button>
    </form>
  </div>

  <article class="mt-panel mt-panel-flush">
    <div class="mt-table-wrap">
      <table class="mt-table">
        <thead>
          <tr>
            <th>Sale</th>
            <th>Date</th>
            <th>Customer</th>
            <th>Cashier</th>
            <th>Payment</th>
            <th>Total</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each sales}}
          <tr class="{{#if (eq status "REFUNDED")}}mt-sale-row-refunded{{else}}{{#if (eq status "PARTIALLY_REFUNDED")}}mt-sale-row-partial{{/if}}{{/if}}">
            <td><strong>{{sale_number}}</strong></td>
            <td>{{dateTime created_at}}</td>
            <td>{{#if customer}}{{customer}}{{else}}Walk-in{{/if}}</td>
            <td>{{cashier}}</td>
            <td>{{payment_methods}}</td>
            <td><strong>TZS {{money total}}</strong></td>
            <td>
              {{#if (eq status "REFUNDED")}}
                <span class="mt-status mt-status-danger">REFUNDED</span>
              {{else}}
                {{#if (eq status "PARTIALLY_REFUNDED")}}
                  <span class="mt-status mt-status-warning">PARTIALLY REFUNDED</span>
                {{else}}
                  <span class="mt-status mt-status-success">{{status}}</span>
                {{/if}}
              {{/if}}
            </td>
            <td class="mt-text-right"><a class="mt-action-link" href="/sales/{{id}}">View</a></td>
          </tr>
          {{else}}
          <tr><td colspan="8"><div class="mt-empty-state">No sales found for this period.</div></td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <div class="mt-pagination-bar">
      <div class="mt-pagination-summary">
        {{#if pagination.totalRows}}
          Showing <strong>{{pagination.firstRow}}–{{pagination.lastRow}}</strong> of <strong>{{pagination.totalRows}}</strong> sales
        {{else}}
          0 sales
        {{/if}}
      </div>

      <nav class="mt-pagination" aria-label="Sales pages">
        {{#if pagination.hasPrevious}}
          <a href="{{pagination.previousUrl}}" class="mt-page-link">‹ Previous</a>
        {{else}}
          <span class="mt-page-link is-disabled">‹ Previous</span>
        {{/if}}

        {{#each pagination.pageLinks}}
          <a href="{{url}}" class="mt-page-link mt-page-number {{#if active}}is-active{{/if}}">{{value}}</a>
        {{/each}}

        {{#if pagination.hasNext}}
          <a href="{{pagination.nextUrl}}" class="mt-page-link">Next ›</a>
        {{else}}
          <span class="mt-page-link is-disabled">Next ›</span>
        {{/if}}
      </nav>

      <div class="mt-pagination-page">
        Page {{pagination.page}} of {{pagination.totalPages}} · 25 rows
      </div>
    </div>
  </article>
</section>
