<!doctype html><html><head><meta charset="utf-8"><title>{{sale.sale_number}}</title><style>body{font-family:monospace;margin:0;background:#eee}.receipt{width:80mm;margin:12px auto;background:#fff;padding:8mm 5mm;color:#111}.center{text-align:center}.receipt h1{font-size:20px;margin:0}.muted{font-size:11px}.line{border-top:1px dashed #222;margin:10px 0}.row{display:flex;justify-content:space-between;gap:8px;margin:5px 0}.items{width:100%;border-collapse:collapse;font-size:11px}.items td{padding:4px 0;vertical-align:top}.total{font-size:15px;font-weight:bold}@media print{body{background:#fff}.receipt{margin:0;width:auto}.no-print{display:none}}</style></head><body><div class="receipt"><div class="center"><h1>{{sale.organization}}</h1><div>{{sale.branch}}</div><div class="muted">{{sale.branch_address}}</div><div class="muted">{{sale.branch_phone}}</div></div><div class="line"></div><div class="row"><span>Receipt</span><strong>{{sale.sale_number}}</strong></div><div class="row"><span>Date</span><span>{{dateTime sale.created_at}}</span></div><div class="row"><span>Cashier</span><span>{{sale.cashier}}</span></div><div class="row"><span>Customer</span><span>{{#if sale.customer}}{{sale.customer}}{{else}}Walk-in{{/if}}</span></div><div class="line"></div><table class="items">{{#each items}}<tr><td>{{name}} {{strength}}<br><span class="muted">{{quantity sale_unit_quantity}} {{#if sale_unit_name}}{{sale_unit_name}}{{else}}unit{{/if}} × {{money sale_unit_price}}</span></td><td style="text-align:right">{{money line_total}}</td></tr>{{/each}}</table><div class="line"></div><div class="row"><span>Subtotal</span><span>{{money sale.subtotal}}</span></div><div class="row"><span>Discount</span><span>{{money sale.discount}}</span></div><div class="row"><span>Tax</span><span>{{money sale.tax}}</span></div><div class="row total"><span>TOTAL TZS</span><span>{{money sale.total}}</span></div><div class="row"><span>Paid</span><span>{{money sale.amount_paid}}</span></div><div class="row"><span>Change</span><span>{{money sale.change_amount}}</span></div><div class="line"></div><div class="center muted">Thank you</div><button class="no-print" onclick="window.print()" style="width:100%;margin-top:14px;padding:10px">Print</button></div></body></html>