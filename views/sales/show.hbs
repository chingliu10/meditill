<section class="mt-page"><div class="mt-page-header"><div><p class="mt-eyebrow">SALE DETAILS</p><h1>{{sale.sale_number}}</h1><p>{{dateTime sale.created_at}} · {{sale.branch}} · {{sale.status}}</p></div><div class="mt-header-actions"><a target="_blank" href="/sales/{{sale.id}}/receipt" class="mt-btn mt-btn-primary mt-btn-lg">Print receipt</a></div></div><div class="mt-sale-summary"><article class="mt-panel mt-panel-body"><span>Customer</span><strong>{{#if sale.customer}}{{sale.customer}}{{else}}Walk-in Customer{{/if}}</strong></article><article class="mt-panel mt-panel-body"><span>Cashier</span><strong>{{sale.cashier}}</strong></article><article class="mt-panel mt-panel-body"><span>Total</span><strong>TZS {{money sale.total}}</strong></article><article class="mt-panel mt-panel-body"><span>Change</span><strong>TZS {{money sale.change_amount}}</strong></article></div><article class="mt-panel mt-panel-flush"><div class="mt-table-wrap"><table class="mt-table"><thead><tr><th>Medicine</th><th>Batch</th><th>Qty</th><th>Price</th><th>Total</th></tr></thead><tbody>{{#each items}}<tr><td><strong>{{name}} {{strength}}</strong><small class="mt-cell-sub">{{generic_name}}</small></td><td>{{batches}}</td><td>{{quantity sale_unit_quantity}} {{sale_unit_name}}</td><td>TZS {{money sale_unit_price}}</td><td><strong>TZS {{money line_total}}</strong></td></tr>{{/each}}</tbody></table></div></article><div class="mt-two-column"><article class="mt-panel"><div class="mt-panel-header"><div><h2>Payments</h2></div></div><div class="mt-list">{{#each payments}}<div class="mt-risk-row"><div><strong>{{payment_method}}</strong><small>{{reference}}</small></div><strong>TZS {{money amount}}</strong></div>{{/each}}</div></article><article class="mt-panel mt-form-panel"><div class="mt-panel-header"><div><h2>Return / refund</h2><p>Partial returns are supported.</p></div></div><form method="post" action="/sales/{{sale.id}}/returns" class="mt-panel-body mt-form-stack"><div class="mt-return-items">{{#each items}}<div class="mt-return-row"><input type="hidden" name="items[{{@index}}][sale_item_id]" value="{{id}}"><span><strong>{{name}} {{strength}}</strong><small>Returnable {{quantity returnable_sale_quantity}} {{sale_unit_name}}</small></span><input type="number" min="0" max="{{returnable_sale_quantity}}" step="{{#if medicine_unit_id}}1{{else}}0.0001{{/if}}" name="items[{{@index}}][quantity]" value="0"></div>{{/each}}</div><label>Reason<input name="reason" required></label><label>Stock disposition<select name="stock_disposition"><option>RETURN_TO_STOCK</option><option>QUARANTINED</option><option>DAMAGED</option></select></label><label>Refund method<select name="refund_method"><option>CASH</option><option>MOBILE_MONEY</option><option>CARD</option><option>BANK</option></select></label><label>Refund reference<input name="refund_reference"></label><button class="mt-btn mt-btn-danger">Process return</button></form></article></div></section>