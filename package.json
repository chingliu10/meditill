{
  "name": "meditill",
  "version": "0.1.0",
  "private": true,
  "description": "Pharmacy-first POS and inventory system using Node.js, Express, PostgreSQL and raw SQL.",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node database/migrate.js",
    "db:seed": "node database/seed.js",
    "db:create-owner": "node scripts/create-owner.js",
    "db:clean-medicine-names": "node scripts/clean-medicine-names.js",
    "check": "node scripts/check-js.js",
    "test:pos-fullscreen": "node --test scripts/tests/pos-fullscreen.test.js",
    "test:pos-ux": "node --test scripts/tests/pos-ux.test.js",
    "test:clean-medicine-names": "node --test scripts/tests/clean-medicine-names.test.js",
    "smoke:core": "node scripts/core-smoke-status.js",
    "perf:seed": "node scripts/perf-seed.js",
    "perf:probe": "node scripts/perf-probe.js",
    "perf:clean": "node scripts/perf-clean.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-handlebars": "^8.0.3",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.3"
  }
}
